# Backend defaults. Put secrets like OPENAI_API_KEY in .env.local.
FRONTEND_URL=http://localhost:5173
PORT=3001

# Local Postgres defaults used by docker-compose.yml
DB_HOST=localhost
DB_PORT=5433
DB_NAME=pensieve
DB_USER=pensieve
DB_PASSWORD=pensieve

# Managed Postgres (Supabase / Neon). If set, this overrides the DB_* vars
# above and enables SSL automatically. Get it from Supabase:
# Project Settings -> Database -> Connection string (Pooler recommended).
# POSTGRES_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres

AI_SUMMARY_MODEL=gpt-4o-mini
AI_SUMMARY_MAX_TOKENS=60
MEMORY_WRITE_RATE_LIMIT=10
MEMORY_WRITE_RATE_LIMIT_WINDOW_MS=600000
MEMORY_RAW_INPUT_MAX_CHARS=2000
