# Backend-only defaults. Put secrets like OPENAI_API_KEY in ../.env.local.

# Local Docker Postgres
DB_HOST=localhost
DB_PORT=5433
DB_NAME=pensieve
DB_USER=pensieve
DB_PASSWORD=pensieve

# Managed Postgres (Supabase / Neon / Vercel). If set, POSTGRES_URL takes
# precedence over the DB_* vars above and SSL is enabled automatically.
#
# Supabase: Project Settings -> Database -> Connection string.
#   - Pooler (recommended, IPv4-friendly, port 6543):
#     POSTGRES_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
#   - Direct (port 5432):
#     POSTGRES_URL=postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres
#
# Neon (Vercel Marketplace sets POSTGRES_URL automatically):
# POSTGRES_URL=postgres://...

PORT=3001
FRONTEND_URL=http://localhost:5173
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
JSON_BODY_LIMIT=8kb
API_RATE_LIMIT=300
MEMORY_WRITE_RATE_LIMIT=10
MEMORY_WRITE_RATE_LIMIT_WINDOW_MS=600000
MEMORY_RAW_INPUT_MAX_CHARS=2000
AI_TIMEOUT_MS=60000
AI_SUMMARY_MODEL=gpt-4o-mini
AI_SUMMARY_MAX_TOKENS=60
